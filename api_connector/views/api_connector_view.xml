<odoo>
    <record id="view_api_connector_form" model="ir.ui.view">
        <field name="name">api.connector.form</field>
        <field name="model">api.connector</field>
        <field name="arch" type="xml">
            <form string="Conector API">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="response_data"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_api_connector_tree" model="ir.ui.view">
        <field name="name">api.connector.tree</field>
        <field name="model">api.connector</field>
        <field name="arch" type="xml">
            <tree string="Conector API">
                <field name="name"/>
                <field name="response_data"/>
            </tree>
        </field>
    </record>

    <menuitem id="menu_api_connector_root" name="API Connector" sequence="10"/>

    <menuitem id="menu_api_connector" name="Registros API" parent="menu_api_connector_root" action="action_api_connector"/>

    <record id="action_api_connector" model="ir.actions.act_window">
        <field name="name">API Connector</field>
        <field name="res_model">api.connector</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>